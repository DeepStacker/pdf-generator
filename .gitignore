.claude/

# Legacy directories (removed in refactor)
app/
logic/
new_bank/
new_files/

# Moved to scripts/
create_distribution_zip.py
BUILD_FOR_MAC_LINUX.sh
BUILD_FOR_WINDOWS.bat
entitlements.plist
requirements.txt

# Coverage
.coverage

# The web SPA's source. This used to be ignored wholesale, for a Pyodide app on
# a branch that no longer exists — which meant the React source of a deployed
# application lived outside version control. Nothing built it in CI or Docker
# either, so the committed bundle was whatever someone last built by hand, and
# the two front ends drifted apart: Flatten PDF shipped a working endpoint that
# no UI ever called.
#
# Only the things a build regenerates are ignored now.
/web/node_modules
/web/dist/
/web/*.tsbuildinfo

# Track build scripts and spec file
!pdf_generator.spec
!scripts/BUILD_FOR_MAC_LINUX.sh
!scripts/BUILD_FOR_WINDOWS.bat
!scripts/create_distribution_zip.py

# Consolidation dynamic files
temp_uploads/
output/
audit_logs/
sources/

# Report validator runtime storage (instant upload jobs)
report_uploads/

# Allow baseline settings and master template
!settings/mapping_rules.xlsx
!templates/Feb'26 consolidated.xlsx


# macOS
.DS_Store

# The browser front end is built from web/ -- the Dockerfile and CI both run
# that build. Committing the output meant a change to web/src only reached
# production if someone remembered to rebuild and commit the bundle too.
audit_engine_web/static/*
!audit_engine_web/static/.gitkeep

# Local run artifacts
report_uploads/
consolidation_audit.json
