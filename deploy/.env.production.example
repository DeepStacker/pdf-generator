# Copy to .env.production (chmod 600) and fill in.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Or let ./bootstrap.sh do all of it for you, which is the short way in on a
# plain Docker host. See AWS.md.

# ---------------------------------------------------------------------------
# Authentication. REQUIRED, for every deployment.
#
# The server refuses every request until GSS_AUTH_PASSWORD_HASH is set, and
# says so in its log. That is deliberate: every route behind it acts on
# customers' audit workbooks, so an unconfigured server must fail closed
# rather than serve openly.
#
# Generate both values without starting anything:
#
#   docker compose -f deploy/compose.aws.yml run --rm --no-deps app \
#       python -m audit_engine_web.setpassword
#
# The password itself is never stored -- only a PBKDF2-SHA256 hash of it, so
# this file cannot give the password back to anyone who reads it.
# ---------------------------------------------------------------------------
GSS_AUTH_PASSWORD_HASH=

# Signs session cookies. Keep it stable: change it and everyone is signed out.
# If unset, one is generated at startup and every restart signs everyone out.
GSS_SECRET_KEY=

# Who signs in first. Defaults to "admin" when unset. More accounts are added
# from the Users screen once you are in.
GSS_AUTH_USER=admin

# ---------------------------------------------------------------------------
# Plain Docker host (compose.aws.yml)
# ---------------------------------------------------------------------------

# Where the published port lands. Bind to 127.0.0.1 when something on this
# host proxies to it; 0.0.0.0 when a load balancer or security group decides
# who may connect.
HOST_PORT=8080
BIND_ADDRESS=0.0.0.0

# Leave this true. A Secure cookie is only sent back over HTTPS, so set it
# false *only* to smoke-test over http://<host>:8080 before TLS is in front --
# otherwise the login form appears to reject the right password. Anything
# other people can reach must have it true.
GSS_COOKIE_SECURE=true

# Only for the optional `proxy` profile, which runs nginx in front of the app.
#
# app.conf     plain HTTP on :80 -- right behind an AWS load balancer, which
#              terminates TLS itself.
# app-tls.conf redirects :80 to :443 and serves TLS from TLS_CERT_DIR, which
#              must hold fullchain.pem and privkey.pem.
#
# Put your own file in deploy/nginx/ and name it here to replace both.
NGINX_CONF=app.conf
TLS_CERT_DIR=./certs

# Where the proxy listens on the host. Leave these alone unless something
# else on the box already owns 80 or 443.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Home server on the tailnet (compose.prod.yml) -- ignore these on AWS.
# ---------------------------------------------------------------------------

# The tailnet hostname. The app answers at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=pdfgengss

# A Tailscale auth key, used once to enrol this container as a device.
# Generate at https://login.tailscale.com/admin/settings/keys
#
# Leave it blank to enrol interactively instead: start the stack, run
#   podman logs -f pdfgen-ts-1
# and open the login URL it prints. The identity is kept in the
# pdfgen_ts_state volume either way, so this is needed only the first time.
TS_AUTHKEY=
